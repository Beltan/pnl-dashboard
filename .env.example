# The dashboard reads nothing but this file. A new chain is a new block of variables, never code.

PORT=8082
HOST=0.0.0.0
AUTH_USER=admin
# Empty leaves every route open. Set it unless something else is guarding the port.
AUTH_PASSWORD=

# How much history to hold, and how often to re-read the chains.
WINDOW_HOURS=24
REFRESH_SECONDS=60

# Comma separated. Each name below prefixes its own variables, upper-cased.
CHAINS=flare

FLARE_RPC_URL=http://93.93.115.220:9650/ext/C/rpc
# Etherscan-compatible API root; Blockscout serves the same shape.
FLARE_EXPLORER_URL=https://flare-explorer.flare.network/api
# Where a transaction link points. Defaults to EXPLORER_URL without its /api.
FLARE_EXPLORER_SITE=https://flare-explorer.flare.network
FLARE_NATIVE_SYMBOL=FLR
FLARE_NATIVE_DECIMALS=18
# GeckoTerminal network id; empty leaves every trade unpriced.
FLARE_GECKO_NETWORK=flare
# The wrapped native token, which is how the gas token gets a price (WFLR here).
FLARE_NATIVE_PRICE_TOKEN=0x1d80c49bbbcd1c0911346656b529df9e5c2f783d
# address[:label], comma separated. Profit is whatever a transaction leaves with any of them.
FLARE_ADDRESSES=0x0d64fab725c4bdb0afa1115560eb19ad3a8e47a6:Arb wallet,0x3417afa3b5487b3abcd4fe55f83f4d3e53750d71:MultiDexFlashSwap

# A second chain is the same block again:
# CHAINS=flare,avax
# AVAX_RPC_URL=https://api.avax.network/ext/bc/C/rpc
# AVAX_EXPLORER_URL=https://api.snowscan.xyz/api
# AVAX_NATIVE_SYMBOL=AVAX
# AVAX_GECKO_NETWORK=avax
# AVAX_NATIVE_PRICE_TOKEN=0xb31f66aa3c1e785363f0875a1b74e27b85fd66c7
# AVAX_ADDRESSES=0x...:Aave operator
