# The dashboard reads nothing but this file. A new chain is a new block of variables, never code.

PORT=8082
HOST=0.0.0.0
AUTH_USER=admin
# Empty leaves every route open. Set it unless something else is guarding the port.
AUTH_PASSWORD=

# History is kept in full, from each address's first transaction. This is only what the page opens on.
WINDOW_HOURS=24
# Seconds between syncs. The first pass backfills and can take a while; passes never overlap.
REFRESH_SECONDS=60
DB_PATH=data/pnl.db

CHAINS=flare,avax

# ---- flare ----
FLARE_EXPLORER_URL=https://flare-explorer.flare.network/api
FLARE_EXPLORER_SITE=https://flare-explorer.flare.network
FLARE_NATIVE_SYMBOL=FLR
FLARE_NATIVE_DECIMALS=18
FLARE_GECKO_NETWORK=flare
# The wrapped native token, which is how the gas token gets a USD price (WFLR).
FLARE_NATIVE_PRICE_TOKEN=0x1d80c49bbbcd1c0911346656b529df9e5c2f783d
# Every lane's contract, and the wallet that drives it. Profit is whatever a transaction leaves
# with any of these; gas counts only when one of them paid it.
FLARE_ADDRESSES=0x3417afa3b5487b3abcd4fe55f83f4d3e53750d71:MultiDexFlashSwap,0xde116cefc1d9c8b91d3cc2ff0b70a6cd7e96947d:MultiDexTroveOps,0x4a38eaad9310d08dd05d9ee71fd4095a4293895b:MultiDexMorphoLiquidation,0xd788c6f49d93d5cf46a381b0dab6bcc5309a3dc2:MultiDexLiquidation,0x0d64fab725c4bdb0afa1115560eb19ad3a8e47a6:Arb wallet,0x5f78b116ecb3160261135b143a7435bd8a7b1eed:Liquity operator,0xbfea9a3f8ff7d677ceae3871fdc8e7d74eadcf6c:Morpho operator

# ---- avax ----
# Routescan serves the Etherscan shape without an API key.
AVAX_EXPLORER_URL=https://api.routescan.io/v2/network/mainnet/evm/43114/etherscan/api
AVAX_EXPLORER_SITE=https://snowtrace.io
AVAX_NATIVE_SYMBOL=AVAX
AVAX_NATIVE_DECIMALS=18
AVAX_GECKO_NETWORK=avax
# WAVAX.
AVAX_NATIVE_PRICE_TOKEN=0xb31f66aa3c1e785363f0875a1b74e27b85fd66c7
# The deployer is the wallet that actually sends on avax - it drove all but six of the transactions
# there - so it is listed as an operator rather than held back as a treasury the way flare's owner is.
AVAX_ADDRESSES=0x93a9f59d5defaae72702dedc2fc4a8fbc287a1ac:MultiDexFlashSwap,0x44c1c3a991aaa8ae19be1e90fd0c4c0c89dc0881:MultiDexAaveLiquidation,0xd08ffe08439e8347d755c8619697d8d3b1b5ead4:MultiDexLiquidation,0xe4e64bacb9785251408404c959cc58894306a29f:Deployer,0x0d64fab725c4bdb0afa1115560eb19ad3a8e47a6:Arb wallet,0x5f78b116ecb3160261135b143a7435bd8a7b1eed:Aave operator

# Flare's owner is left out: it sent 54 transactions against the operators' 154,000, so it is a
# treasury rather than a trader and counting it would skew every rate on the page. Add it only to
# follow sweeps, and read the counts knowing that.
#   flare owner 0x5b81be097636a687572c5939856d1cd6ef327007
